rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regla para la colección users
    match /users/{userEmail} {
      allow read, write: if request.auth != null && request.auth.token.email == userEmail;
    }
    
    // Regla para la colección exams (para futuras funcionalidades)
    match /exams/{examId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.exams.hasAny([examId]);
    }
  }
} 